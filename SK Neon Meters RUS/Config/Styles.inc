; ====================================
; ========== TEXT STYLES DEFINITION ==
; ====================================

[StyleGraphLabels]
FontFace=Century Gothic
FontColor=255,255,255,255	-- White
SolidColor=0,0,0,1
StringStyle=Normal
StringAlign=Center
AntiAlias=1
FontSize=12
StringEffect=Border
FontEffectColor=0,0,0,255
;InlineSetting=Shadow | 0 | 0 | 3 | 0,0,0,255

[StyleGraphData]
